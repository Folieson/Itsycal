#!/bin/sh
# commit-msg hook: enforce Conventional Commits via the shared validator.
# Enabled by: git config core.hooksPath .githooks

set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
validator="$root/scripts/check-commit-message.sh"

if [ ! -f "$validator" ]; then
  printf 'commit-msg: %s not found; skipping commit message check\n' "$validator" >&2
  exit 0
fi

exec sh "$validator" "$1"
