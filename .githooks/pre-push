#!/bin/sh
# pre-push hook: refuse history rewrites and branch deletion on protected branches.
#
# A free private GitHub repository cannot use server-side branch protection or rulesets,
# so this hook is the local replacement for "no force pushes, no branch deletion" on
# `main`. Fast-forward pushes and pushes to other branches pass unchanged.
#
# Enabled by: git config core.hooksPath .githooks
# Deliberate bypass: git push --no-verify

set -u
protected='refs/heads/main'
zero='0000000000000000000000000000000000000000'
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue
  if [ "$local_sha" = "$zero" ]; then
    printf 'pre-push: refusing to delete %s\n' "$remote_ref" >&2
    blocked=1
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    continue
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    printf 'pre-push: refusing non-fast-forward push to %s (it would rewrite history)\n' "$remote_ref" >&2
    printf '          push a branch and open a pull request instead.\n' >&2
    blocked=1
  fi
done

[ "$blocked" -eq 0 ] || exit 1
exit 0
