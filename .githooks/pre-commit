#!/bin/sh
# pre-commit hook: block the cheap mistakes before a commit object exists.
# Checks staged content only, needs no Node.js, and keeps the happy path silent.
# Enabled by: git config core.hooksPath .githooks

set -u
fail=0

report() {
  printf 'pre-commit: %s\n' "$1" >&2
  fail=1
}

# 1. Conflict markers in staged content.
markers=$(git grep --cached -l -I -E '^(<<<<<<< |=======$|>>>>>>> )' -- . 2>/dev/null || true)
if [ -n "$markers" ]; then
  report "conflict markers found in staged files:"
  printf '%s\n' "$markers" | sed 's/^/  /' >&2
fi

# 2. Destination-level safety for each added or modified staged path.
for path in $(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null); do
  case "$path" in
    AGENTS.local.md|CLAUDE.local.md|*/AGENTS.local.md|*/CLAUDE.local.md)
      report "personal instruction overlay must not be committed: $path"
      continue
      ;;
    .agents/worktrees/*|*/.agents/worktrees/*|.dsh-tmp/*|*/.dsh-tmp/*)
      report "agent scratch path must not be committed: $path"
      continue
      ;;
  esac
  size=$(git cat-file -s ":$path" 2>/dev/null || printf '0')
  if [ "${size:-0}" -gt 5242880 ]; then
    report "staged file is larger than 5 MB: $path ($size bytes)"
  fi
done

if [ "$fail" -ne 0 ]; then
  printf 'pre-commit: fix the items above, or bypass deliberately with "git commit --no-verify".\n' >&2
  exit 1
fi

exit 0
